{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "公式ログフォルダと、ダイアログで選んだフォルダの読み取りだけを許可する。ディスク全体や、画面からの書き込み・SQL は許可しない。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-get-portable-dir",
    "allow-remember-log-directory",
    "allow-remembered-log-directory",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log" },
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log" },
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" }
      ]
    }
  ]
}
