{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ログフォルダの読み取りと、exe 隣の data への読み書きを許可する。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" },
        { "path": "$EXE/data/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log" },
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" },
        { "path": "$EXE/data" },
        { "path": "$EXE/data/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" },
        { "path": "$EXE/data/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" },
        { "path": "$EXE/data/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        { "path": "$DOCUMENT/SEGA/PHANTASYSTARONLINE2/log/**" },
        { "path": "**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$EXE/data" },
        { "path": "$EXE/data/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$EXE/data/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$EXE/data/**" }
      ]
    }
  ]
}
