{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MesetaLedger",
  "version": "0.1.0",
  "identifier": "dev.meseta.ledger",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter web dev:tauri",
    "beforeBuildCommand": "pnpm --filter web build:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
